
{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM"],
        "types": ["vite/client"],
        "strict": true,
        "resolveJsonModule": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "skipLibCheck": true
    },
    "vueCompilerOptions": {
        "plugins": ["@vue/language-plugin-pug"]
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
