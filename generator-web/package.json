{
    "name": "bookcover-web",
    "version": "0.14.0",
    "license": "MIT-0",
    "repository": {
        "type": "git",
        "url": "https://github.com/gracious-tech/bookcover.git",
        "directory": "generator-web"
    },
    "homepage": "https://github.com/gracious-tech/bookcover/tree/main/generator-web#readme",
    "bugs": "https://github.com/gracious-tech/bookcover/issues",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./patterns-svg": {
            "types": "./dist/patterns_svg.d.ts",
            "default": "./dist/patterns_svg.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch"
    },
    "dependencies": {
        "@myriaddreamin/typst-ts-renderer": "0.7.0",
        "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
        "@myriaddreamin/typst.ts": "0.7.0",
        "bookcover-core": "^0.14.0",
        "typst-fonts": "^0.1.0"
    },
    "sideEffects": false
}
