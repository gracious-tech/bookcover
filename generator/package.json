{
    "name": "bookcover-core",
    "version": "0.15.0",
    "license": "MIT-0",
    "repository": {
        "type": "git",
        "url": "https://github.com/gracious-tech/bookcover.git",
        "directory": "generator"
    },
    "homepage": "https://github.com/gracious-tech/bookcover/tree/main/generator#readme",
    "bugs": "https://github.com/gracious-tech/bookcover/issues",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./patterns-svg": {
            "types": "./dist/patterns_svg.d.ts",
            "default": "./dist/patterns_svg.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/",
        "!dist/**/*.map"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "vitest run"
    },
    "dependencies": {
        "@types/chroma-js": "^3.1.2",
        "big.js": "^7.0.1",
        "bwip-js": "^4.9.0",
        "chroma-js": "^3.2.0",
        "pm-to-typst": "^0.1.0",
        "printing-services": "^1.5.1",
        "typst-fonts": "^0.1.0",
        "typst-utils": "^0.2.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/big.js": "^6.2.2",
        "fast-check": "^4.10.2",
        "vitest": "^5.0.1"
    },
    "sideEffects": false
}
