#!/usr/bin/env node

// Bundles generator/vector_bg_images/*.svg (hand-editable source SVGs, using
// #6e79ac/#be89b3/#76538e as placeholder colors) into
// generator/src/generated/vector_bg_images_data.ts so tsc can inline them as plain string
// constants — the generated file is gitignored and rebuilt by build_generator. The source SVGs
// live outside src/ (and outside the top-level assets/ tree, which is reserved for
// statically-served runtime assets) since they're a codegen input, not TS source.

import {readdir, readFile, writeFile, mkdir} from 'fs/promises'
import {join, dirname, basename} from 'path'
import {fileURLToPath} from 'url'

const root = join(dirname(fileURLToPath(import.meta.url)), '..')
const src_dir = join(root, 'generator/vector_bg_images')
const out_file = join(root, 'generator/src/generated/vector_bg_images_data.ts')

const files = (await readdir(src_dir)).filter(f => f.endsWith('.svg')).sort()

const entries = await Promise.all(files.map(async file => {
    const id = basename(file, '.svg')
    const text = await readFile(join(src_dir, file), 'utf8')
    return `    ${JSON.stringify(id)}: ${JSON.stringify(text.trim())},`
}))

const out = '// GENERATED by .bin/gen_vector_bg_images from generator/vector_bg_images/*.svg — do not edit\n'
    + '// Edit the source .svg files instead, then rerun the generator build\n\n'
    + '/** Raw SVG text for each vector background image, keyed by id, with placeholder colors\n'
    + ' *  (#6e79ac/#be89b3/#76538e) swapped for a real palette by recolor_svg() in vector_backgrounds.ts */\n'
    + 'export const VECTOR_BG_IMAGE_SVGS:Record<string, string> = {\n'
    + entries.join('\n')
    + '\n}\n'

await mkdir(dirname(out_file), {recursive: true})
await writeFile(out_file, out)
console.log('Generated', out_file, 'from', files.length, 'vector bg images')
