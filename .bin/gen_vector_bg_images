#!/usr/bin/env node

// Bundles generator/vector_bg_images/*.svg (hand-editable source SVGs, using
// #6e79ac/#be89b3/#76538e and their dark/light variants as placeholder colors) into
// generator/src/generated/ so tsc can inline them as plain string constants:
// - vector_bg_images/<id>.ts — one module per design, its raw SVG text as the default export
// - vector_bg_images_data.ts — the id list, plus a loader per design that dynamic-imports its
//   module, so a bundler splits every design into its own chunk and an app only downloads the
//   designs it actually renders
// All generated files are gitignored and rebuilt by build_generator. The source SVGs live
// outside src/ (and outside the top-level assets/ tree, which is reserved for statically-served
// runtime assets) since they're a codegen input, not TS source.

import {readdir, readFile, writeFile, mkdir, rm} from 'fs/promises'
import {join, dirname, basename} from 'path'
import {fileURLToPath} from 'url'

const root = join(dirname(fileURLToPath(import.meta.url)), '..')
const src_dir = join(root, 'generator/vector_bg_images')
const out_dir = join(root, 'generator/src/generated/vector_bg_images')
const out_file = join(root, 'generator/src/generated/vector_bg_images_data.ts')

const HEADER = '// GENERATED by .bin/gen_vector_bg_images from generator/vector_bg_images/*.svg — do not edit\n'
    + '// Edit the source .svg files instead, then rerun the generator build\n\n'

const ids = (await readdir(src_dir)).filter(f => f.endsWith('.svg')).map(f => basename(f, '.svg')).sort()

// One module per design, cleared first so a deleted source can't leave a stale one behind
await rm(out_dir, {recursive: true, force: true})
await mkdir(out_dir, {recursive: true})
await Promise.all(ids.map(async id => {
    const text = await readFile(join(src_dir, `${id}.svg`), 'utf8')
    await writeFile(join(out_dir, `${id}.ts`), HEADER
        + '/** Raw SVG text, placeholder colors still in (see recolor_vector_svg() in vector_backgrounds.ts) */\n'
        + `export default ${JSON.stringify(text.trim())}\n`)
}))

// The id list and a lazy loader per design
const loaders = ids.map(id => `    '${id}': () => import('./vector_bg_images/${id}.js').then(m => m.default),`)
await writeFile(out_file, HEADER
    + '/** Id of every vector background image (its source filename without .svg), sorted */\n'
    + 'export const VECTOR_BG_IDS:string[] = [\n'
    + ids.map(id => `    '${id}',`).join('\n')
    + '\n]\n\n'
    + '/** Load one design\'s raw SVG text, keyed by id — each is its own module, so only the\n'
    + ' *  designs actually loaded are ever downloaded */\n'
    + 'export const VECTOR_BG_IMAGE_LOADERS:Record<string, () => Promise<string>> = {\n'
    + loaders.join('\n')
    + '\n}\n')
console.log('Generated', out_file, 'and', ids.length, 'design modules in', out_dir)
