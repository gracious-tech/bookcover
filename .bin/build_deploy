#!/usr/bin/env bash
# CI build script — installs all workspaces from the root lockfile, then builds
# Output: widget/dist/ and site/dist/
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$PROJECT_ROOT/.bin"

echo "📦 Installing dependencies (all workspaces)..."
cd "$PROJECT_ROOT"
npm ci

echo "🔨 Building typst helpers, generator, generator-web and 3d..."
"$BIN/build_web"

echo "🔨 Building widget..."
"$BIN/build_widget"

echo "🔨 Building site..."
"$BIN/build_site"

echo "✅ Build complete! Output: widget/dist/ and site/dist/"
