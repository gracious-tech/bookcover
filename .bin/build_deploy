#!/usr/bin/env bash
# Netlify build script — installs all workspaces from the root lockfile, then builds
# Output: widget/dist/
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$PROJECT_ROOT/.bin"

echo "📦 Installing dependencies (all workspaces)..."
cd "$PROJECT_ROOT"
npm ci

echo "🔨 Building typst helper packages..."
"$BIN/build_typst-utils"
"$BIN/build_typst-fonts"
"$BIN/build_pm-to-typst"

echo "🔨 Building generator module..."
"$BIN/build_generator"

echo "🔨 Building generator-web module..."
"$BIN/build_generator-web"

echo "🔨 Building 3d module..."
"$BIN/build_3d"

echo "🔨 Building widget..."
"$BIN/build_widget"

echo "✅ Build complete! Output: widget/dist/"
