#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/../typst/typst-fonts"

# Clear stale output first — tsc only writes files, so outputs whose sources were since
# renamed or deleted linger in dist/, and every package ships all of dist/ to npm
rm -rf dist

npx tsc

# The CLI is linked into node_modules/.bin, and npm only sets its executable bit at install time
# — which clearing dist/ undoes
chmod +x dist/download/cli.js
