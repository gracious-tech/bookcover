#!/usr/bin/env bash
set -euo pipefail

# Bundles precomputed ImageRegions (background-image auto color-matching data) for every
# builtin photo in assets/backgrounds/ into generator/src/generated/builtin_bg_regions.ts — a committed
# data file (like patterns.ts), NOT part of the regular build_generator codegen chain, since
# it's comparatively expensive (a real image decode per photo) and only needs to change when
# assets/backgrounds/ does. Sampled against a fixed reference size (6in x 9in trim, 250-page
# Lulu paperback) rather than any specific cover being generated — see
# generator/src/generated/builtin_bg_regions.ts's doc comment for why that's an acceptable approximation.
# Run this after adding, removing, or replacing a file in assets/backgrounds/, then commit the
# regenerated builtin_bg_regions.ts alongside the asset change.

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Build generator so its dist exports analyze_pixel_regions/resolve_dimensions (uses the
# existing builtin_bg_regions.ts as-is — that's fine, this script overwrites it below)
cd "$ROOT/generator" && npm run build --silent

ROOT="$ROOT" node --input-type=module <<'EOF'
import {createRequire} from 'module'
import {readdir, readFile, writeFile} from 'fs/promises'
import {join} from 'path'

const root = process.env.ROOT
const {analyze_pixel_regions, resolve_dimensions} = await import(join(root, 'generator/dist/index.js'))

// Load sharp from generator-node's node_modules, same as gen_bg_thumbnails
const require = createRequire(join(root, 'generator-node/package.json'))
const sharp = require('sharp')

// Downscale target — must match widget/src/services/image_regions.ts's MAX_DIM so builtin and
// live-analyzed images are sampled at the same effective resolution
const MAX_DIM = 400
const src_dir = join(root, 'assets/backgrounds')

// Fixed reference: 6in x 9in trim, 250-page paperback — see builtin_bg_regions.ts for why a
// single reference size is an acceptable approximation for the full-wrap region proportions
const dims = resolve_dimensions({
    service_id: 'lulu',
    size_id: 'us_trade',
    page_count: 250,
    binding_type: 'paperback',
    ink_type: 'bw',
    paper_type: 'white',
})

const files = (await readdir(src_dir)).filter(f => f.endsWith('.jpg')).sort()

// Cross-check the directory against the widget's ID lists. This runs here because this script
// is what you run when the asset set changes — the moment the two can drift apart. A name with
// no file can no longer be rendered by any cover that stored it; a file with no name is either
// an unlisted addition or a retirement that forgot RETIRED_BACKGROUNDS (see the contract at the
// top of widget/src/services/backgrounds.ts)
const bg_src = await readFile(join(root, 'widget/src/services/backgrounds.ts'), 'utf8')
const listed = new Set()
for (const list of ['BACKGROUNDS', 'RETIRED_BACKGROUNDS']) {
    // Capture to the first ']' — handles an empty RETIRED_BACKGROUNDS without running on into
    // the next list (entries are plain quoted strings, so the body never contains a bracket)
    const block = bg_src.match(new RegExp(`export const ${list}:\\s*string\\[\\] = \\[([^\\]]*)\\]`))
    for (const m of block?.[1].matchAll(/'([^']+)'/g) ?? [])
        listed.add(m[1])
}
const missing_file = [...listed].filter(name => !files.includes(name))
const unlisted = files.filter(name => !listed.has(name))
if (missing_file.length)
    throw new Error(`Listed in backgrounds.ts but missing from assets/backgrounds/: `
        + `${missing_file.join(', ')} — covers naming these can no longer render`)
if (unlisted.length)
    console.warn(`Warning: in assets/backgrounds/ but listed in neither BACKGROUNDS nor `
        + `RETIRED_BACKGROUNDS: ${unlisted.join(', ')}`)

// Values are averages/std-devs over an already-quantized (8-bit, JPEG-compressed) pixel
// sample, consumed only via coarse threshold comparisons in design.ts — float64's ~17
// significant digits is precision the source data never had, so round it off before it's
// baked into the committed file
const round = n => Math.round(n * 1000) / 1000
const round_regions = regions => Object.fromEntries(Object.entries(regions).map(([key, r]) => [
    key,
    {hue: round(r.hue), saturation: round(r.saturation), lightness: round(r.lightness), lightness_spread: round(r.lightness_spread)},
]))

const entries = []
for (const file of files) {
    const src_path = join(src_dir, file)
    const meta = await sharp(src_path).metadata()
    const scale = Math.min(1, MAX_DIM / Math.max(meta.width, meta.height))
    const w = Math.max(1, Math.round(meta.width * scale))
    const h = Math.max(1, Math.round(meta.height * scale))
    const {data} = await sharp(src_path).resize(w, h).ensureAlpha().raw()
        .toBuffer({resolveWithObject: true})
    const regions = round_regions(analyze_pixel_regions(data, w, h, dims))
    entries.push({file, width: meta.width, height: meta.height, regions})
    console.log('  ' + file)
}

const lines = entries.map(({file, width, height, regions}) =>
    `    ${JSON.stringify(file)}: {width: ${width}, height: ${height}, `
        + `regions: ${JSON.stringify(regions)}},`)

const out = '\n// GENERATED by .bin/gen_bg_regions from assets/backgrounds/*.jpg — do not edit by hand.\n'
    + '// Rerun the script after adding, removing, or changing a builtin background image.\n\n'
    + "import type {ImageRegions} from '../design.js'\n\n"
    + '/** One built-in background photo\'s baked metadata */\n'
    + 'export interface BuiltinBg {\n'
    + '    width:number\n'
    + '    height:number\n'
    + '    regions:ImageRegions\n'
    + '}\n\n'
    + '/** Precomputed ImageRegions for every builtin background photo (assets/backgrounds/<key>),\n'
    + ' *  sampled against a fixed reference size — a 6in x 9in trim, 250-page Lulu paperback — rather\n'
    + " *  than the actual cover being generated, since the source photo's dominant colors barely shift\n"
    + ' *  across trim sizes/spine widths and doing this once at build time skips a real image decode\n'
    + " *  (measured 100-350ms for this app's own background photos) for the common case of a builtin\n"
    + ' *  pick. The filename key is the built-in\'s ID, so get_builtin_bg_regions() looks entries up by\n'
    + ' *  it alone — the regions hold for the preview-sized copy, or any visually identical\n'
    + ' *  re-encode, too: they are a rough colour read, not a fingerprint. `width`/`height` are the\n'
    + " *  original's pixel size, for resolution checks without downloading it. Callers fall back to a\n"
    + ' *  live analyze_pixel_regions() for anything not in this table. */\n'
    + 'export const BUILTIN_BG_REGIONS:Record<string, BuiltinBg> = {\n'
    + lines.join('\n')
    + '\n}\n'

await writeFile(join(root, 'generator/src/generated/builtin_bg_regions.ts'), out)
console.log('Generated builtin_bg_regions.ts from', files.length, 'images')
EOF

# Rebuild generator so the new data file is baked into dist
cd "$ROOT/generator" && npm run build --silent
echo "Done — generator rebuilt with updated builtin_bg_regions.ts"
