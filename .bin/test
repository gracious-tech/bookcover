#!/usr/bin/env bash
# Run every package's automated test suite, in dependency order.
# For the manual visual check (generates real PDF/SVG/PNG covers), see .bin/test_examples
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Packages import their workspace siblings through those siblings' dist/ (package.json exports),
# so a fresh checkout can't resolve them until built. This also runs generator's codegen, which
# its suite reads directly. tsc is the native TypeScript 7 compiler, so it takes ~2s
"$ROOT/.bin/build_modules"

# Every package with a suite, in dependency order. generator-node renders with the real typst
# binary and fonts tree and skips itself when either is missing (see its tests/render.test.ts)
PACKAGES=(
    typst/typst-utils
    typst/typst-fonts
    typst/pm-to-typst
    generator
    generator-node
    generator-web
    3d
    widget
    site
)

for package in "${PACKAGES[@]}"; do
    echo
    echo "==> $package"
    cd "$ROOT/$package" && npx vitest run "$@"
done
