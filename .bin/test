#!/usr/bin/env bash
# Run every package's automated test suite, in dependency order.
# For the manual visual check (generates real PDF/SVG/PNG covers), see .bin/test_covers
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# generator's suite builds the schema from its baked-in codegen, so make sure it exists
"$ROOT/.bin/gen_vector_bg_images"
"$ROOT/.bin/gen_icon_svgs"
"$ROOT/.bin/gen_typst_templates"

# Every package with a suite, in dependency order. generator-node renders with the real typst
# binary and fonts tree and skips itself when either is missing (see its tests/render.test.ts)
PACKAGES=(
    typst/typst-utils
    typst/typst-fonts
    typst/pm-to-typst
    generator
    generator-node
    3d
    widget
)

for package in "${PACKAGES[@]}"; do
    echo
    echo "==> $package"
    cd "$ROOT/$package" && npx vitest run "$@"
done
