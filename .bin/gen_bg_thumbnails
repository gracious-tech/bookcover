#!/usr/bin/env node

import {createRequire} from 'module'
import {readdir, mkdir, rm} from 'fs/promises'
import {join, dirname} from 'path'
import {fileURLToPath} from 'url'

// Resolve project root from script location
const root = join(dirname(fileURLToPath(import.meta.url)), '..')

// Load sharp from generator-node's node_modules
const require = createRequire(join(root, 'generator-node/package.json'))
const sharp = require('sharp')

const src_dir = join(root, 'assets/backgrounds')
const thumb_dir = join(src_dir, 'thumbnails')
const preview_dir = join(src_dir, 'previews')

console.log('Generating background thumbnails...')

// Clear existing output dirs and recreate them
await rm(thumb_dir, {recursive: true, force: true})
await rm(preview_dir, {recursive: true, force: true})
await mkdir(thumb_dir, {recursive: true})
await mkdir(preview_dir, {recursive: true})

const files = (await readdir(src_dir)).filter(f => f.endsWith('.jpg'))

for (const file of files) {
    await sharp(join(src_dir, file))
        .resize(160, 120, {fit: 'cover', position: 'centre'})
        .jpeg({quality: 80})
        .toFile(join(thumb_dir, file))
    await sharp(join(src_dir, file))
        .resize(800, null, {withoutEnlargement: true})
        .jpeg({quality: 80})
        .toFile(join(preview_dir, file))
    console.log('  ' + file)
}
console.log('Done:', files.length, 'thumbnails ->', thumb_dir)
console.log('Done:', files.length, 'previews ->', preview_dir)
