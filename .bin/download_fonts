#!/usr/bin/env node

// Download curated Google Fonts into generator/assets/fonts/
// Uses the Google Fonts download list API to fetch Regular/Bold/Italic/BoldItalic TTFs.
// After downloading, generates generator/src/font_manifest.json with the font metadata.

import {writeFile, mkdir} from 'node:fs/promises'
import {dirname, join, basename} from 'node:path'
import {fileURLToPath} from 'node:url'

const __dirname = dirname(fileURLToPath(import.meta.url))
const GENERATOR_DIR = join(__dirname, '..', 'generator')
const FONT_DIR = join(GENERATOR_DIR, 'assets', 'fonts')
const MANIFEST_PATH = join(GENERATOR_DIR, 'src', 'generated', 'font_manifest.json')
const API = 'https://fonts.google.com/download/list'

// Font families to download, organized by group (shown as subheadings in the widget UI)
const FONT_GROUPS = [
    {
        group: 'Compatible with most languages',
        fonts: [
            'Noto Serif',  // Fallback / generic serif
            'Noto Sans',  // Generic sans
        ],
    },
    {
        group: 'Styles',
        fonts: [
            'Dancing Script',  // Fancy
            'Caveat',  // Casual
            'Playpen Sans',  // Childlike
            'Raleway',  // Spacious
            'Special Elite',  // Uncertainty
            'Bevan',  // Fatface
        ],
    },
    {
        group: 'Commonly used inside books',
        fonts: [
            'EB Garamond',
            'Merriweather',
            'Crimson Pro',
            'Libre Baskerville',
            'Lora',
        ],
    },
]

// Flat list for iteration
const FONTS = FONT_GROUPS.flatMap(g => g.fonts)

// Map family name → group name
const FONT_GROUP_MAP = new Map(
    FONT_GROUPS.flatMap(g => g.fonts.map(f => [f, g.group]))
)

// Desired static weight suffixes
const WEIGHTS = ['Regular', 'Bold', 'Italic', 'BoldItalic']

// Download a font and return the list of downloaded filenames
async function download_font(family) {
    const dir = join(FONT_DIR, family)
    await mkdir(dir, {recursive: true})

    // Fetch API response and strip )]}' security prefix
    const url = `${API}?family=${encodeURIComponent(family)}`
    const resp = await fetch(url)
    if (!resp.ok) {
        throw new Error(`API returned ${resp.status} for "${family}"`)
    }
    const raw = await resp.text()
    const json = JSON.parse(raw.replace(/^\)\]\}'\s*/, ''))
    const refs = json.manifest.fileRefs

    // Base name = family with spaces removed (Google's filename convention)
    const base = family.replace(/\s+/g, '')
    const files = []

    // Try static files for the 4 core weights
    for (const suffix of WEIGHTS) {
        const target = `${base}-${suffix}.ttf`
        let ref = refs.find(r => basename(r.filename) === target)

        // Some fonts (e.g. Merriweather) use optical-size filenames like Base_24pt-Regular.ttf.
        // Fall back to the smallest optical-size variant, excluding condensed/semicondensed.
        if (!ref) {
            const pattern = new RegExp(`^${base}_\\d+pt-${suffix}\\.ttf$`)
            const candidates = refs
                .filter(r => pattern.test(basename(r.filename)))
                .sort((a, b) => basename(b.filename).localeCompare(basename(a.filename), undefined, {numeric: true}))
            if (candidates.length > 0) {
                ref = candidates[0]
            }
        }

        if (ref) {
            // Always save with the canonical name so downstream code doesn't need to know about optical sizes
            const data = await fetch(ref.url)
            await writeFile(join(dir, `${base}-${suffix}.ttf`), new Uint8Array(await data.arrayBuffer()))
            files.push(`${base}-${suffix}.ttf`)
        }
    }

    // Require at least Regular weight
    if (files.length === 0) {
        throw new Error(`No static font files found for "${family}"`)
    }

    return files
}

// Pick the preview file: prefer *-Regular.ttf, else first file
function pick_preview(files) {
    return files.find(f => f.includes('-Regular.')) ?? files[0]
}

// Generate the JSON manifest file from download results
async function write_manifest(results) {
    const entries = results.map(r => ({
        family: r.family,
        group: FONT_GROUP_MAP.get(r.family),
        files: r.files,
        preview_file: r.preview_file,
    }))
    await mkdir(dirname(MANIFEST_PATH), {recursive: true})
    await writeFile(MANIFEST_PATH, JSON.stringify(entries, null, 4) + '\n')
    console.log(`\nGenerated ${MANIFEST_PATH}`)
}

// Run all downloads and generate manifest
console.log(`Downloading ${FONTS.length} fonts to generator/assets/fonts/\n`)

const results = []
for (const family of FONTS) {
    process.stdout.write(`  ${family}...`)
    try {
        const files = await download_font(family)
        const preview_file = pick_preview(files)
        results.push({family, files, preview_file})
        console.log(` ${files.length} files`)
    } catch (err) {
        console.log(` FAILED: ${err.message}`)
    }
}

await write_manifest(results)
console.log('Done.')
