#!/usr/bin/env bash

# Download this app's fonts into the top-level assets/fonts/ directory (published separately from the
# app). Noto Serif/Sans + the full per-script Noto fallback system are always included by
# typst-fonts; font_config.json supplies the additional curated fonts this app wants.
#
# --remove-overlaps merges the overlapping glyph contours Google Fonts leaves in its static
# TTFs, which otherwise print as white gaps on even-odd print RIPs (Lulu's among them). It needs
# python3 with fonttools + skia-pathops (`pip install fonttools skia-pathops`, or a venv on PATH).

set -euo pipefail
cd "$(dirname "$0")/.."

# Runs the local typst-fonts workspace's CLI directly (build it first: .bin/build_typst-fonts).
# Not via npx: npm only links a workspace bin whose file exists at install time, which on a
# fresh checkout it doesn't (dist/ isn't in git), and npx then looks the name up on the npm
# registry instead — where anyone could publish a package by that name.
CLI=typst/typst-fonts/dist/download/cli.js
if [ ! -f "$CLI" ]; then
    echo "typst-fonts isn't built — run .bin/build_typst-fonts first" >&2
    exit 1
fi

node "$CLI" --fonts assets/fonts --config font_config.json --remove-overlaps
