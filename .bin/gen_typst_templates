#!/usr/bin/env node

// Bundles generator/typst/*.typ (the Typst cover templates) into
// generator/src/generated/templates_data.ts so tsc can inline them as plain string constants —
// the generated file is gitignored and rebuilt by build_generator. The source .typ files live
// outside src/ (and outside the top-level assets/ tree, which is reserved for statically-served
// runtime assets) since they're a codegen input, not TS source — this ties the templates to the
// exact published bookcover-core version, so node/web consumers don't need to fetch or supply
// cover.typ / _helpers.typ at runtime.

import {readFile, writeFile, mkdir} from 'fs/promises'
import {join, dirname} from 'path'
import {fileURLToPath} from 'url'

const root = join(dirname(fileURLToPath(import.meta.url)), '..')
const src_dir = join(root, 'generator/typst')
const out_file = join(root, 'generator/src/generated/templates_data.ts')

const cover = await readFile(join(src_dir, 'cover.typ'), 'utf8')
const helpers = await readFile(join(src_dir, '_helpers.typ'), 'utf8')

const out = '// GENERATED by .bin/gen_typst_templates from generator/typst/*.typ — do not edit\n'
    + '// Edit the source .typ files instead, then rerun the generator build\n\n'
    + "import type {Templates} from '../build_files.js'\n\n"
    + '/** The cover.typ / _helpers.typ templates baked in at this package version */\n'
    + 'export const DEFAULT_TEMPLATES:Templates = {\n'
    + `    cover: ${JSON.stringify(cover)},\n`
    + `    helpers: ${JSON.stringify(helpers)},\n`
    + '}\n'

await mkdir(dirname(out_file), {recursive: true})
await writeFile(out_file, out)
console.log('Generated', out_file)
