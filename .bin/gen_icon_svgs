#!/usr/bin/env node

// Bundles generator/icon_svgs/*.svg (hand-editable source SVGs, using currentColor for the fill
// so resolve_icon() in icon_cache.ts can recolor them the same way as a fetched Iconify icon)
// into generator/src/generated/icon_svgs_data.ts so tsc can inline them as plain string
// constants — the generated file is gitignored and rebuilt by build_generator. The source SVGs
// live outside src/ (and outside the top-level assets/ tree, which is reserved for
// statically-served runtime assets) since they're a codegen input, not TS source.

import {readdir, readFile, writeFile, mkdir} from 'fs/promises'
import {join, dirname, basename} from 'path'
import {fileURLToPath} from 'url'

const root = join(dirname(fileURLToPath(import.meta.url)), '..')
const src_dir = join(root, 'generator/icon_svgs')
const out_file = join(root, 'generator/src/generated/icon_svgs_data.ts')

const files = (await readdir(src_dir)).filter(f => f.endsWith('.svg')).sort()

const entries = await Promise.all(files.map(async file => {
    const id = basename(file, '.svg')
    // Strip width/height so the icon scales via its container, matching the stripping
    // icon_cache.ts applies to icons fetched from the Iconify API
    const text = (await readFile(join(src_dir, file), 'utf8'))
        .replace(/<svg\b[^>]*>/, tag => tag.replace(/\s(?:width|height)="[^"]*"/g, ''))
    return `    ${JSON.stringify(id)}: ${JSON.stringify(text.trim())},`
}))

const out = '// GENERATED by .bin/gen_icon_svgs from generator/icon_svgs/*.svg — do not edit\n'
    + '// Edit the source .svg files instead, then rerun the generator build\n\n'
    + '/** Raw SVG text for each bundled built-in icon, keyed by id, using currentColor so\n'
    + ' *  resolve_icon() in icon_cache.ts can recolor them like any Iconify icon */\n'
    + 'export const BUILTIN_ICON_SVGS:Record<string, string> = {\n'
    + entries.join('\n')
    + '\n}\n'

await mkdir(dirname(out_file), {recursive: true})
await writeFile(out_file, out)
console.log('Generated', out_file, 'from', files.length, 'builtin icons')
