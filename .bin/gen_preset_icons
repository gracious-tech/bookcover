#!/usr/bin/env node

// Bundles generator/preset_icon_svgs/<collection>/<name>.svg (committed source, downloaded by
// the maintainer-only .bin/fetch_preset_icons from the Iconify API) into
// generator/src/generated/preset_icons_svg_data.ts so tsc can inline them as plain string
// constants — the generated file is gitignored and rebuilt by build_generator, same pattern as
// gen_icon_svgs for the hand-drawn builtin icons. Keeping these baked in (rather than fetched
// live) is what stops every client hitting api.iconify.design at runtime — see icon_cache.ts.

import {readdir, readFile, writeFile, mkdir} from 'fs/promises'
import {join, dirname} from 'path'
import {fileURLToPath} from 'url'

const root = join(dirname(fileURLToPath(import.meta.url)), '..')
const src_dir = join(root, 'generator/preset_icon_svgs')
const out_file = join(root, 'generator/src/generated/preset_icons_svg_data.ts')

const collections = (await readdir(src_dir, {withFileTypes: true}))
    .filter(d => d.isDirectory())
    .map(d => d.name)
    .sort()

const entries = []
for (const collection of collections) {
    const collection_dir = join(src_dir, collection)
    const files = (await readdir(collection_dir)).filter(f => f.endsWith('.svg')).sort()
    for (const file of files) {
        const name = file.slice(0, -'.svg'.length)
        const id = `${collection}:${name}`
        const text = (await readFile(join(collection_dir, file), 'utf8')).trim()
        entries.push(`    ${JSON.stringify(id)}: ${JSON.stringify(text)},`)
    }
}

const out = '// GENERATED by .bin/gen_preset_icons from generator/preset_icon_svgs/**/*.svg — do not edit\n'
    + '// Edit the source .svg files (or re-run .bin/fetch_preset_icons) instead, then rerun the generator build\n\n'
    + '/** Raw SVG text for each bundled preset icon, keyed by its full Iconify id\n'
    + ' *  (e.g. "game-icons:dead-wood"), using currentColor so resolve_icon() in icon_cache.ts\n'
    + ' *  can recolor them like a live-fetched Iconify icon */\n'
    + 'export const PRESET_ICON_SVGS:Record<string, string> = {\n'
    + entries.join('\n')
    + '\n}\n'

await mkdir(dirname(out_file), {recursive: true})
await writeFile(out_file, out)
console.log('Generated', out_file, 'from', entries.length, 'preset icons')
