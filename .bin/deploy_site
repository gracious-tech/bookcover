#!/usr/bin/env bash

# Publish the built site (site/dist/) to the site bucket served at https://cover.paper.bible/
# (an S3 bucket behind CloudFront — see infra/cloudformation.yml). Build first with
# .bin/build_site; this script only uploads.
#
# The widget is NOT deployed by this — it has its own bucket and hostname and goes up via
# .bin/deploy_widget. The site only points an iframe at it.
#
# Usage:
#   .bin/deploy_site
#   STACK=paper-cover-staging .bin/deploy_site

set -euo pipefail
cd "$(dirname "$0")/.."

STACK="${STACK:-paper-cover}"
# us-west-2 unless told otherwise; AWS_REGION is what the CI workflows set
REGION="${REGION:-${AWS_REGION:-us-west-2}}"

if [ ! -f site/dist/index.html ]; then
    echo "site/dist/ is not built — run .bin/build_site first" >&2
    exit 1
fi

# Read a value out of the CloudFormation stack rather than hardcoding names setup_aws owns
stack_output(){
    aws cloudformation describe-stacks --region "$REGION" --stack-name "$STACK" \
        --query "Stacks[0].Outputs[?OutputKey=='$1'].OutputValue | [0]" --output text
}

BUCKET="${BUCKET:-$(stack_output SiteBucketName)}"
DISTRIBUTION="${DISTRIBUTION:-$(stack_output SiteDistributionId)}"

if [ -z "$BUCKET" ] || [ "$BUCKET" = "None" ]; then
    echo "Could not resolve the site bucket from stack $STACK (run .bin/setup_aws)" >&2
    exit 1
fi

# Content-hashed bundles first, so the live entry point never references files that aren't
# there yet. No --delete, for the same reason as deploy_widget: a visitor mid-session may
# still fetch a chunk from the build being replaced.
aws s3 sync site/dist "s3://$BUCKET" \
    --exclude 'index.html' \
    --cache-control 'public, max-age=31536000, immutable'

# The entry point is the one mutable file, so it must not be cached anywhere
aws s3 cp site/dist/index.html "s3://$BUCKET/index.html" \
    --cache-control 'no-cache' \
    --content-type 'text/html; charset=utf-8'

# CloudFront holds index.html under its own no-cache behaviour, but the SPA error-response
# mapping can still have a copy, so purge the one path explicitly
if [ -n "$DISTRIBUTION" ] && [ "$DISTRIBUTION" != "None" ]; then
    echo -n 'Invalidation: '
    aws cloudfront create-invalidation --distribution-id "$DISTRIBUTION" \
        --paths '/index.html' '/' \
        --query 'Invalidation.Id' --output text
fi

echo "Deployed site/dist to s3://$BUCKET"
